    "Lock your Mac with ⌃⌘Q, or start the screen saver, to see it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 ⌃⌘Q 锁定 Mac，或启动屏幕保护程序即可看到效果。"
