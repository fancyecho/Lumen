    },
    "Click a wallpaper to add it, and click again to take it out.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击壁纸即可加入，再次点击移出。"
          }
        }
      }
    },
    "Drag to reorder. With Shuffle on, the order is mixed each time the rotation starts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可调整顺序。开启随机后，每次开始轮换都会重新打乱。"
          }
        }
      }
    },
